  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: #F5F7FA;
    color: #132337;
    font-family: "Inter", "SF Pro Display", "Segoe UI";
}

QWidget#centralwidget {
    background: #F5F7FA;
}

QFrame#sidebar {
    background: #0D2436;
    border: none;
}

QFrame#sidebar QLabel {
    color: #EAF2F8;
}

QFrame#sidebar QPushButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #B8C7D2;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 12px;
    text-align: left;
}

QFrame#sidebar QPushButton:hover {
    background: #17364D;
    color: #FFFFFF;
}

QFrame#sidebar QPushButton[active="true"] {
    background: #1C4C66;
    color: #FFFFFF;
}

QScrollArea#rightRailScroll {
    background: transparent;
    border: none;
}

QScrollArea#rightRailScroll > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #7F93A3;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QFrame#panel,
QFrame#tablePanel,
QFrame#formPanel,
QFrame#chartPanel,
QFrame#miniPanel,
QFrame#securityPanel {
    background: #FFFFFF;
    border: 1px solid #E3E9EF;
    border-radius: 12px;
}

QFrame#summaryCard1,
QFrame#summaryCard2,
QFrame#summaryCard3,
QFrame#summaryCard4 {
    background: #FFFFFF;
    border: 1px solid #E3E9EF;
    border-radius: 12px;
}

QLabel#screenTitle {
    color: #10263B;
    font-size: 26px;
    font-weight: 800;
}

QLabel#screenSubtitle,
QLabel#mutedLabel1,
QLabel#mutedLabel2,
QLabel#mutedLabel3,
QLabel#mutedLabel4,
QLabel#mutedLabel5,
QLabel#mutedLabel6,
QLabel#mutedLabel7,
QLabel#mutedLabel8,
QLabel#mutedLabel9,
QLabel#mutedLabel10 {
    color: #647487;
    font-size: 12px;
    font-weight: 600;
}

QLabel#cardTitle1,
QLabel#cardTitle2,
QLabel#cardTitle3,
QLabel#cardTitle4,
QLabel#panelTitle1,
QLabel#panelTitle2,
QLabel#panelTitle3,
QLabel#panelTitle4 {
    color: #263A4F;
    font-size: 13px;
    font-weight: 700;
}

QLabel#lblTotalAccounts,
QLabel#lblTotalSavings,
QLabel#lblTotalInvestments,
QLabel#lblActiveAccounts {
    color: #10263B;
    font-size: 24px;
    font-weight: 800;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background: #FFFFFF;
    border: 1px solid #D6E0EA;
    border-radius: 8px;
    color: #14283C;
    font-weight: 700;
    min-height: 34px;
    padding: 6px 12px;
    selection-background-color: #1F7A68;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #1F7A68;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 0px;
}

QSpinBox::up-arrow,
QSpinBox::down-arrow,
QDoubleSpinBox::up-arrow,
QDoubleSpinBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}

QPushButton {
    border-radius: 8px;
    font-weight: 700;
    min-height: 34px;
    padding: 8px 14px;
}

QPushButton#btnAdd {
    background: #1F7A68;
    border: 1px solid #1F7A68;
    color: #FFFFFF;
}

QPushButton#btnAdd:hover {
    background: #176555;
}

QPushButton#btnClear {
    background: #EEF3F7;
    border: 1px solid #D6E0EA;
    color: #263A4F;
}

QPushButton#btnDelete {
    background: #FFF1F1;
    border: 1px solid #F1B9B9;
    color: #B42318;
}

QPushButton#btnDelete:hover {
    background: #FFE4E4;
}

QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E3E9EF;
    border-radius: 10px;
    color: #132337;
    gridline-color: #E7EDF3;
    selection-background-color: #DCEFEA;
    selection-color: #10263B;
}

QHeaderView::section {
    background: #EDF3F8;
    border: none;
    border-right: 1px solid #DDE6EE;
    color: #41546A;
    font-size: 12px;
    font-weight: 800;
    min-height: 34px;
    padding: 8px;
}

QTableWidget::item {
    padding: 8px;
}

QCheckBox {
    color: #41546A;
    font-weight: 600;
}

QListWidget {
    background: transparent;
    border: none;
    color: #41546A;
}

QListWidget::item {
    border-radius: 8px;
    padding: 8px;
}

QListWidget::item:selected {
    background: #DCEFEA;
    color: #10263B;
}</string>
